# ==========================================================================
# Chefix — variáveis de ambiente
# Copie para .env.local e preencha. Nunca comite chaves reais.
# ==========================================================================

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.chefix.com.br

# App do cliente (login / área do cliente)
NEXT_PUBLIC_APP_URL=https://app.chefix.com.br

# WhatsApp (somente dígitos, com DDI e DDD)
NEXT_PUBLIC_WHATSAPP=5500000000000

# --------------------------------------------------------------------------
# PAGAMENTOS
# Provedor ativo: "asaas" | "mercadopago" | "mock"
# Use "mock" em desenvolvimento (nenhuma chamada externa é feita).
# --------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# Ambiente do provedor: "sandbox" | "production"
PAYMENT_ENV=sandbox

# --- Asaas ---
# Sandbox: https://sandbox.asaas.com  |  Produção: https://api.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# ANALYTICS (opcional)
# --------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
